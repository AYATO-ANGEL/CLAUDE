          <mxGeometry x="785" y="420" width="330" height="95" as="geometry" />
        </mxCell>

        <mxCell id="r5a" value="&lt;b&gt;5 &#183; ORQUESTACION&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="31">
          <mxGeometry x="45" y="515" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r5b" value="El orden: pasos, subagentes, transiciones, que va en paralelo y que espera." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="235" y="515" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r5c" value="&#191;Quien hace que, en que orden y cuando se pasa la posta?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="505" y="515" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r5d" value="/a-orquestador convocando a los 5 agentes de area en la mesa de debate." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="785" y="515" width="330" height="95" as="geometry" />
        </mxCell>

        <mxCell id="r6a" value="&lt;b&gt;6 &#183; EVALUACION&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="31">
          <mxGeometry x="45" y="610" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r6b" value="Con que vara se mide el resultado y quien pone la nota." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="235" y="610" width="270" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r6c" value="&#191;Funciono de verdad, o solo respondio bonito?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="505" y="610" width="280" height="95" as="geometry" />
        </mxCell>
        <mxCell id="r6d" value="a-evaluador con RUBRICAS.md (R1-R4): APRUEBA / CORRIGE, max. 3 vueltas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="31">
          <mxGeometry x="785" y="610" width="330" height="95" as="geometry" />
        </mxCell>

        <mxCell id="p3n" value="&lt;b&gt;Truco para no perderse:&lt;/b&gt; cuando algo salga mal, no preguntes &#8220;&#191;que modelo uso?&#8221;. Pregunta &#8220;&#191;en cual de estas 6 filas se rompio?&#8221;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="31">
          <mxGeometry x="45" y="725" width="1070" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="pag4" name="4-POR DONDE EMPEZAR">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="40" />
        <mxCell id="41" parent="40" />

        <mxCell id="p4t" value="&lt;b&gt;POR DONDE EMPEZAR — EL ORDEN QUE SI FUNCIONA&lt;/b&gt;" style="text;html=1;fontSize=22;align=center;verticalAlign=middle;" vertex="1" parent="41">
          <mxGeometry x="40" y="25" width="1090" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p4st" value="No construyas el orquestador primero. Se construye de abajo hacia arriba, y la vara de medir se define ANTES de crecer." style="text;html=1;fontSize=13;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="41">
          <mxGeometry x="40" y="63" width="1090" height="26" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1. PROMPT&lt;/b&gt;&lt;br&gt;&lt;br&gt;Escribe la instruccion y pruebala a mano hasta que salga bien 3 veces seguidas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="41">
          <mxGeometry x="42" y="230" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2. CONTEXTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;Dale solo lo que necesita ver. Ni de mas (ruido) ni de menos (inventa)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="41">
          <mxGeometry x="227" y="230" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3. EVALUACION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Define la vara AHORA: que es &#8220;bien hecho&#8221; y quien lo dice. (Aqui es donde casi todos fallan.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;strokeWidth=3;" vertex="1" parent="41">
          <mxGeometry x="412" y="230" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4. HARNESS&lt;/b&gt;&lt;br&gt;&lt;br&gt;Ponle herramientas y barandas: que pueda tocar, que no, y que hacer si se equivoca." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="41">
          <mxGeometry x="597" y="230" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5. AGENTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Recien aqui lo conviertes en agente con memoria y autonomia propia." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="41">
          <mxGeometry x="782" y="230" width="160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6. ORQUESTACION&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cuando ya tienes 2 o 3 agentes buenos, recien pones al director a coordinarlos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="41">
          <mxGeometry x="967" y="230" width="160" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="41" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="41" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="41" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="41" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;" edge="1" parent="41" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" value="&lt;b&gt;vuelve a medir en cada vuelta&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=3;dashed=1;strokeColor=#b85450;fontColor=#b85450;fontSize=12;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="41" source="s6" target="s3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1047" y="430" />
              <mxPoint x="492" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="p4r" value="&lt;b&gt;3 REGLAS PARA NO PERDER TIEMPO&lt;/b&gt;" style="text;html=1;fontSize=15;align=left;verticalAlign=middle;" vertex="1" parent="41">
          <mxGeometry x="42" y="490" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p4r1" value="&lt;b&gt;1. Un agente nuevo solo si ya duele.&lt;/b&gt;&lt;br&gt;Si una tarea la haces bien con un prompt y buen contexto, NO le hagas agente. El agente cuesta mantenimiento." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="41">
          <mxGeometry x="42" y="530" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4r2" value="&lt;b&gt;2. El orquestador no trabaja, reparte.&lt;/b&gt;&lt;br&gt;Si el director tambien redacta el informe, ya no es director: es un cuello de botella caro." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="41">
          <mxGeometry x="410" y="530" width="350" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4r3" value="&lt;b&gt;3. Sin evaluacion no hay sistema, hay suerte.&lt;/b&gt;&lt;br&gt;Si nadie mide, no sabes si mejoraste o solo cambiaste. El a-evaluador es obligatorio antes de entregar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="41">
          <mxGeometry x="778" y="530" width="350" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p4m" value="&lt;b&gt;En una frase:&lt;/b&gt; el PROMPT dice que hacer &#183; el CONTEXTO dice con que &#183; el AGENTE lo hace &#183; el HARNESS lo cuida &#183; el ORQUESTADOR lo coordina &#183; la EVALUACION dice si sirvio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;align=center;" vertex="1" parent="41">
          <mxGeometry x="42" y="680" width="1086" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
